                  "key": "token",
                  "value": "{{tokenOperador}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Estado 1\", function () {",
                  "    pm.expect(pm.response.json().estado).to.eql(\"PENDIENTE_PESAJE_INICIAL\");",
                  "});"
                ]
              }
            }
          ]
