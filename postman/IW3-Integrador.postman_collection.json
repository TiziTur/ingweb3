    {
      "name": "1 - Circuito completo",
      "item": [
        {
          "name": "1 - Recibir orden (SAP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ordenes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ordenes"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenSap}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroOrden\": {{numeroOrden}},\n  \"fechaPrevistaCarga\": \"2026-11-10T10:00:00-03:00\",\n  \"preset\": 3000,\n  \"camion\": {\n    \"codigoExterno\": \"CAM-001\",\n    \"patente\": \"AB123CD\",\n    \"descripcion\": \"Camión cisterna\",\n    \"cisternas\": [\n      {\n        \"numero\": 1,\n        \"capacidadLitros\": 10000\n      },\n      {\n        \"numero\": 2,\n        \"capacidadLitros\": 5000\n      }\n    ]\n  },\n  \"chofer\": {\n    \"codigoExterno\": \"CHO-001\",\n    \"nombre\": \"Juan\",\n    \"apellido\": \"Pérez\",\n    \"documento\": \"30111222\"\n  },\n  \"cliente\": {\n    \"codigoExterno\": \"CLI-001\",\n    \"razonSocial\": \"Gas del Centro SA\",\n    \"contacto\": \"compras@gasdelcentro.com\"\n  },\n  \"producto\": {\n    \"codigoExterno\": \"PRO-001\",\n    \"nombre\": \"Propano\",\n    \"descripcion\": \"Gas licuado de petróleo\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Punto 1. SAP envía la orden. Camión, chofer, cliente y producto se crean o actualizan por codigoExterno. La orden queda en estado 1."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera un número de orden nuevo en cada ejecución, así el circuito se puede repetir",
                  "pm.environment.set(\"numeroOrden\", Math.floor(Date.now() / 1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver orden recién creada (OPERADOR)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ordenes/{{numeroOrden}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ordenes",
                "{{numeroOrden}}"
              ]
